# Copy to backend/.env and fill in. Never commit the real file.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

VEILDROP_SESSION_SECRET=
VEILDROP_DATABASE_URL=postgresql://veildrop:CHANGE_ME@localhost:5432/veildrop
# Superuser URL, used only by RLS tests and ops tooling.
VEILDROP_POSTGRES_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres

VEILDROP_LOG_LEVEL=INFO
VEILDROP_LOG_FORMAT=json

# Comma-separated exact origins. Must NOT be "*" in production — the app
# refuses to start with a wildcard when allow_credentials is on.
VEILDROP_CORS_ORIGINS=http://127.0.0.1:8000

# Bearer token for GET /metrics. Leave empty to disable the endpoint (404).
VEILDROP_METRICS_TOKEN=

# Ed25519 receipt signing keypair.
VEILDROP_RECEIPT_KEY_PATH=config/receipt_ed25519.key
VEILDROP_RECEIPT_VERIFY_KEY_PATH=config/receipt_ed25519.pub

# Contact address shown on the public site's Contact page.
VEILDROP_CONTACT_EMAIL=
